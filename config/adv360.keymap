#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        login: login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "LOGIN";
        };

        dryerDrives: dryerDrives {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N2 &kp COMMA &kp SPACE &kp N3 &kp N3 &kp COMMA &kp SPACE &kp N3 &kp N4 &kp COMMA &kp SPACE &kp N3 &kp N5>;
            label = "DRYERDRIVES";
        };

        wetEnd: wetEnd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp COMMA &kp SPACE &kp N4 &kp COMMA &kp SPACE &kp N5 &kp COMMA &kp SPACE &kp N1 &kp N0>;
            label = "WETEND";
        };

        ropeSheave: ropeSheave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N0 &kp COMMA &kp SPACE &kp N2 &kp N0 &kp COMMA &kp SPACE &kp N3>;
            label = "ROPESHEAVE";
        };

        lube: lube {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp COMMA &kp SPACE &kp N1 &kp N0 &kp COMMA &kp SPACE &kp N2 &kp N0>;
            label = "LUBE";
        };

        parc: parc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp I &kp L &kp DOT &kp P &kp I &kp DOT &kp M &kp N2 &kp COLON>;
            label = "PARC";
        };

        tavg: tavg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp A &kp V &kp G &kp EQUAL &kp N1 &kp N5 &kp M>;
            label = "TAVG";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1          &kp N2          &kp N3            &kp N4              &kp N5  &tog 1                                                                 &mo 3        &kp N6  &kp N7               &kp N8             &kp N9           &kp N0              &kp MINUS
&kp TAB    &kp Q           &kp W           &kp E             &kp R               &kp T   &login                                                                 &parc        &kp Y   &kp U                &kp I              &kp O            &kp P               &kp BSLH
&mkp LCLK  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &kp G   &mkp LCLK  &mkp LCLK       &kp DELETE           &kp LGUI   &kp ESCAPE  &tavg        &kp H   &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C             &kp V               &kp B                              &kp PRINTSCREEN      &kp PG_UP                           &kp N   &kp M                &kp COMMA          &kp DOT          &kp FSLH            &kp RSHFT
&mo 2      &kp GRAVE       &caps_word      &kp LEFT          &kp RIGHT                   &kp BSPC   &kp LEFT_SHIFT  &kp TAB              &kp PG_DN  &kp ENTER   &lt 2 SPACE          &kp UP               &kp DOWN           &kp LBKT         &kp RBKT            &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1        &kp KP_NUMLOCK   &kp KP_EQUAL     &kp KP_SLASH     &kp KP_MULTIPLY  &trans                                                             &mo 3      &kp N6           &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &ropeSheave   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS     &none                                                              &none      &kp EXCLAMATION  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp EXCL
&lube      &dryerDrives  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &none     &kp SPACE     &kp DEL             &kp LGUI   &kp ESCAPE  &none      &kp DOLLAR       &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp DOLLAR
&kp LSHFT  &wetEnd       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT                               &kp UP_ARROW        &kp PG_UP                         &kp AT_SIGN      &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp AT
&mo 2      &kp GRAVE     &kp KP_COMMA     &kp LEFT         &kp RIGHT                         &kp BSPC  &kp KP_ENTER  &kp DOWN_ARROW      &kp PG_DN  &kp ENTER   &kp KP_N0                   &kp UP      &kp DOWN      &kp KP_DOT     &kp KP_COMMA     &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3          &kp F4          &kp F5           &kp F6    &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans    &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp UP    &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans          &trans          &trans           &kp DOWN                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans          &mkp LCLK       &mkp RCLK                  &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
