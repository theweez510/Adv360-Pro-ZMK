#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        login: login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(DELETE))>;
            label = "LOGIN";
        };

        dryerDrives: dryerDrives {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N2 &kp COMMA &kp SPACE &kp N3 &kp N3 &kp COMMA &kp SPACE &kp N3 &kp N4 &kp COMMA &kp SPACE &kp N3 &kp N5>;
            label = "DRYERDRIVES";
        };

        wetEnd: wetEnd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp COMMA &kp SPACE &kp N4 &kp COMMA &kp SPACE &kp N5 &kp COMMA &kp SPACE &kp N1 &kp N0>;
            label = "WETEND";
        };

        ropeSheave: ropeSheave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N0 &kp COMMA &kp SPACE &kp N2 &kp N0 &kp COMMA &kp SPACE &kp N3>;
            label = "ROPESHEAVE";
        };

        lube: lube {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp COMMA &kp SPACE &kp N1 &kp N0 &kp COMMA &kp SPACE &kp N2 &kp N0>;
            label = "LUBE";
        };

        parc: parc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp I &kp L &kp DOT &kp P &kp I &kp DOT &kp M &kp N2 &kp COLON>;
            label = "PARC";
        };

        tavg: tavg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp A &kp V &kp G &kp EQUAL &kp N1 &kp N5 &kp M>;
            label = "TAVG";
        };

        TS: TS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp LS(S)>;
            label = "TS";
        };

        DS: DS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp LS(S)>;
            label = "DS";
        };

        Press1: Press1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp S &kp T &kp SPACE &kp LS(P) &kp R &kp E &kp S &kp S &kp SPACE>;
            label = "PRESS1";
        };

        Press2: Press2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N &kp D &kp SPACE &kp LS(P) &kp R &kp E &kp S &kp S &kp SPACE>;
            label = "PRESS2";
        };

        lumpbreaker: lumpbreaker {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(L) &kp U &kp M &kp P &kp SPACE &kp LS(B) &kp R &kp E &kp A &kp K &kp E &kp R &kp SPACE>;
            label = "LUMPBREAKER";
        };

        steamin: steamin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp T &kp E &kp A &kp M &kp SPACE &kp LS(B) &kp O &kp X &kp SPACE &kp LS(I) &kp N &kp SPACE>;
            label = "STEAMIN";
        };

        steamout: steamout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp T &kp E &kp A &kp M &kp SPACE &kp LS(B) &kp O &kp X &kp SPACE &kp LS(O) &kp U &kp T &kp SPACE>;
            label = "STEAMOUT";
        };

        headbox: headbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp E &kp A &kp D &kp SPACE &kp LS(B) &kp O &kp X &kp SPACE>;
            label = "HEADBOX";
        };

        dryer1: dryer1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp R &kp Y &kp E &kp R &kp SPACE &kp LS(C) &kp A &kp N &kp SPACE &kp POUND &kp N1 &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE &kp LS(T) &kp LS(S)>;
            label = "DRYER1";
        };

        dryer7: dryer7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp R &kp Y &kp E &kp R &kp SPACE &kp LS(C) &kp A &kp N &kp SPACE &kp POUND &kp N7 &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE &kp LS(T) &kp LS(S)>;
            label = "DRYER7";
        };

        dryer19: dryer19 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp R &kp Y &kp E &kp R &kp SPACE &kp LS(C) &kp A &kp N &kp SPACE &kp POUND &kp N1 &kp N9 &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE &kp LS(T) &kp LS(S)>;
            label = "DRYER19";
        };

        dryer35: dryer35 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp R &kp Y &kp E &kp R &kp SPACE &kp LS(C) &kp A &kp N &kp SPACE &kp POUND &kp N3 &kp N5 &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE &kp LS(D) &kp LS(S)>;
            label = "DRYER35";
        };
    };

    behaviors {
        #include "macros.dtsi"
          #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        holdlogin: holdlogin {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDLOGIN";
            bindings = <&login>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        msmv: moused_mv_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "mouse_mv_kp";
            bindings = <&mmv>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        msscrl: msscrl {
            compatible = "zmk,behavior-hold-tap";
            label = "MSSCRL";
            bindings = <&msc>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        holdtavg: holdtavg {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAVG";
            bindings = <&tavg>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        holdparc: holdparc {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDPARC";
            bindings = <&parc>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        mskp: mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "Mouse_kp";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        bracket_plus: bracket_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKET_PLUS";
            bindings = <&kp LEFT_BRACKET>, <&kp PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        bracket_star: bracket_star {
            compatible = "zmk,behavior-mod-morph";
            label = "BRACKET_STAR";
            bindings = <&kp RIGHT_BRACKET>, <&kp STAR>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL              &kp N1          &kp N2          &kp N3                  &kp N4                      &kp N5  &tog 1                                                                                               &tog 4       &kp N6  &kp N7                      &kp N8                  &kp N9           &kp N0              &kp MINUS
&kp DELETE             &kp Q           &kp W           &kp E                   &kp R                       &kp T   &holdtavg 0 F12                                                                                      &mo 3        &kp Y   &kp U                       &kp I                   &kp O            &kp P               &kp BSLH
&kp LEFT_PARENTHESIS   &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_SHIFT D        &hm LEFT_CONTROL F          &kp G   &holdparc 0 F3   &msscrl SCRL_UP RCLK    &kp DELETE                    &hm RIGHT_GUI F4  &kp ESCAPE  &kp EQUAL    &kp H   &hm RIGHT_CONTROL J         &hm RIGHT_SHIFT K       &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI  &kp SQT
&kp RIGHT_PARENTHESIS  &kp Z           &kp X           &kp C                   &kp V                       &kp B                                            &holdlogin 0 PRINTSCREEN      &mkp MB4                                   &kp N   &kp M                       &hm PLUS COMMA          &kp STAR         &kp FSLH            &kp ESCAPE
&mo 2                  &kp GRAVE       &caps_word      &msmv MOVE_UP UP_ARROW  &msmv MOVE_DOWN DOWN_ARROW          &kp BACKSPACE    &msscrl SCRL_DOWN LCLK  &mskp MCLK TAB                &mskp MB5 TAB     &kp ENTER   &lt 1 SPACE          &msmv MOVE_LEFT LEFT_ARROW  &msmv MOVE_RIGHT RIGHT  &bracket_plus    &bracket_star       &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL       &kp PERCENT     &kp KP_N7        &kp KP_N8     &kp KP_NUMBER_9  &kp KP_MULTIPLY  &trans                                                                  &mo 3      &kp PERCENT      &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB         &kp AMPERSAND   &kp KP_NUMBER_4  &kp KP_N5     &kp KP_N6        &kp KP_MINUS     &kp LA(ENTER)                                                           &none      &kp EXCLAMATION  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp EXCL
&kp AT_SIGN     &kp DOLLAR      &kp KP_N1        &kp KP_N2     &kp KP_N3        &kp KP_PLUS      &kp F4         &kp SPACE     &kp UP_ARROW        &kp LGUI   &kp ESCAPE  &none      &kp DOLLAR       &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp DOLLAR
&kp ESC         &kp COLON       &kp KP_N0        &kp KP_COMMA  &kp KP_DOT       &kp KP_SLASH                                  &kp DOWN_ARROW      &kp PG_UP                         &kp AT_SIGN      &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp AT
&kp KP_NUMLOCK  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp UP_ARROW  &kp DOWN                          &kp BSPC       &kp KP_ENTER  &kp TAB             &kp PG_DN  &kp ENTER   &kp KP_N0                   &kp UP      &kp DOWN      &kp KP_DOT     &kp KP_COMMA     &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3          &kp F4          &kp F5           &kp F6    &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans    &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp UP    &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans          &trans          &trans           &kp DOWN                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans          &mkp LCLK       &mkp RCLK                  &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Flir {
            bindings = <
&trans  &trans   &trans   &trans        &trans     &trans    &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &dryer1  &dryer7  &dryer19      &dryer35   &headbox  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &Press2  &Press1  &lumpbreaker  &steamout  &steamin  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &TS           &DS        &trans                    &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans        &trans               &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
